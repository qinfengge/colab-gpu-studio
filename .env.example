# Run: uv run python scripts/init_env.py --site-url https://your-own-domain.example
ENVIRONMENT=production
SITE_URL=http://localhost:8788
DATABASE_URL=sqlite:///./data/studio.db
DATA_DIR=./data
STUDIO_PASSWORD=
ENCRYPTION_KEY=
SESSION_SECRET=
STUDIO_API_TOKEN=
GPU_AGENT_TOKEN=
GPU_AGENT_OWNER_ID=owner
GPU_ENABLED=1
GPU_REAL_ENABLED=0
# Trusted executor plugins are administrator-only and disabled by default.
GPU_TRUSTED_EXECUTOR_ENABLED=0
GPU_TRUSTED_EXECUTOR_MODULE=
GPU_TRUSTED_EXECUTOR_ENTRYPOINT=
GPU_TRUSTED_EXECUTOR_VERSION=
GPU_TRUSTED_EXECUTOR_ALLOWLIST=
GPU_TRUSTED_EXECUTOR_CACHE_NAMESPACE=trusted
GPU_COMPUTE_PROVIDER=kaggle
GPU_STORAGE=drive
GPU_MODEL_CACHE=kaggle
KAGGLE_USERNAME=
# Keep credentials on the server. Use KAGGLE_API_TOKEN or local kaggle.json.
KAGGLE_API_TOKEN=
# Comma-separated private Dataset references; layout matches manifest weight target paths.
KAGGLE_MODEL_DATASETS=
# Existing Studio Google account UUID with Drive OAuth, not Colab compute authorization.
KAGGLE_DRIVE_ACCOUNT_ID=
GPU_MAX_RUNTIME_MINUTES=30
GPU_DAILY_UNITS=10
GPU_MONTHLY_UNITS=100
GPU_MAX_JOB_UNITS=5
# compute units PER MINUTE, administrator estimate, never advertised as actual billing
GPU_UNIT_RATE=
GPU_CREATE_RETRIES=2
GPU_CREATE_TIMEOUT_SECONDS=30
GPU_GOOGLE_CLIENT_ID=
GPU_GOOGLE_CLIENT_SECRET=
GPU_GOOGLE_REDIRECT_URI=
BIND_IP=127.0.0.1
BIND_PORT=8788
